index 0000000..4632d51
--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/quantization/matmul_nbits_q2_decode.h
@@ -0,0 +1,45 @@
+// Copyright (c) Quick Inference contributors.
+// Licensed under the MIT License.
+// Quick Inference patch: a faster 2-bit MatMulNBits kernel for few rows of A (decoding).
+
+#pragma once
+
+#include "core/providers/webgpu/program.h"
+#include "core/providers/webgpu/compute_context.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+using namespace onnxruntime::webgpu;
+
+// Each team of 32 lanes computes kQ2DecodeRowsPerTeam output rows; a lane takes 32 weights (two words) of each row
+// per step, keeping its 32 values of A in registers for all of them. Weights are decoded four at a time: byte b of a
+// word holds weights 4b..4b+3, (vec4(byte) >> (0, 2, 4, 6)) & 3 puts them in a vec4<u32>, and OR-ing 0x4b000000 makes
+// floats 2^23 + q, so one subtraction gives q - zero (2) exactly.
+class MatMulNBitsQ2DecodeProgram final : public Program<MatMulNBitsQ2DecodeProgram> {
+ public:
+  MatMulNBitsQ2DecodeProgram(bool has_bias, bool use_subgroups)
+      : Program{"MatMulNBitsQ2Decode"}, has_bias_{has_bias}, use_subgroups_{use_subgroups} {}
