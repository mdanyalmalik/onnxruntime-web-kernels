+  if (channels_last_) {
+    body << "  let batch_idx = global_idx / uniforms.channels;\n"
+            "  let channel_idx = global_idx % uniforms.channels;\n"
+            "  let base_state = batch_idx * uniforms.channels * uniforms.state_length + channel_idx;\n"
+            "  let state_stride = uniforms.channels;\n"
+            "  let base_input = batch_idx * uniforms.channels * uniforms.input_length + channel_idx;\n"
+            "  let input_stride = uniforms.channels;\n";
+  } else {
+    body << "  let base_state = global_idx * uniforms.state_length;\n"
+            "  let state_stride = 1u;\n"
+            "  let base_input = global_idx * uniforms.input_length;\n"
+            "  let input_stride = 1u;\n";
+  }
+  const std::string past = past_input_ ? "conv_state" : "present_state";
+  body << "  let past_base = base_state + (uniforms.state_window - 1u) * uniforms.slot_stride;\n"
+          "  var prev: array<input_element_t, 16>;\n"
+          "  if (uniforms.has_past != 0u) {\n"
+          "    for (var s = 0u; s < uniforms.state_length; s++) { prev[s] = input_element_t("
+       << past << "[past_base + s * state_stride]); }\n"
+          "  }\n"
+          "  let L = uniforms.input_length;\n"
+          "  let W = uniforms.state_window;\n"
+          "  let S = uniforms.state_length;\n"
+          "  for (var t = select(0u, L - W, L > W); t < L; t++) {\n"
+          "    let slot_base = base_state + (t + W - L) * uniforms.slot_stride;\n"
+          "    for (var s = 0u; s < S; s++) {\n"
+          "      let vp = t + 1u + s;\n"
+          "      var value = input_element_t(0.0);\n"
+          "      if (vp < S) { value = prev[vp]; } else { value = input[base_input + (vp - S) * input_stride]; }\n"
+          "      present_state[slot_base + s * state_stride] = value;\n"
+          "    }\n"
+          "  }\n"
+          "  if (uniforms.zero_leading_slots != 0u) {\n"
+          "    for (var slot = 0u; slot + L < W; slot++) {\n"
+          "      for (var s = 0u; s < S; s++) { present_state[base_state + slot * uniforms.slot_stride + s * state_stride] = input_element_t(0.0); }\n"
+          "    }\n"
+          "  }\n";
+  return Status::OK();
+}
