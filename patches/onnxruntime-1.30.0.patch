+}  // namespace
+
+Status MatMulGgmlDecodeProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("input_a", ShaderUsage::UseValueTypeAlias);
+  AddWeightInputs(shader, type_, true);
+  shader.AddOutput("output", ShaderUsage::UseElementTypeAlias);
+  shader.AdditionalImplementation() << "const M: u32 = " << rows_ << "u;\n";
+  if (!use_subgroups_) {
+    shader.AdditionalImplementation() << "var<workgroup> partial: array<f32, " << kDecodeTeams * 32 << ">;\n";
+  }
+  auto& body = shader.MainFunctionBody();
+  const uint32_t R = DecodeRowsPerTeam(rows_);
+  body << "  load_grid(local_idx, " << kDecodeTeams * 32 << "u);\n"
+       << "  let team = local_idx / 32u;\n"
+       << "  let lane = local_idx % 32u;\n"
+       << "  let first = (workgroup_idx * " << kDecodeTeams << "u + team) * " << R << "u;\n";
+  for (uint32_t r = 0; r < R; r++) body << "  var acc" << r << ": array<f32, M>;\n";
+  body << "  for (var s = lane; s < uniforms.steps; s += 32u) {\n";
+  if (rows_ == 1) {
+    // One row of A: its 32 values in registers, each row's weights summed into the product as they are decoded.
+    body << "    var x: array<vec4<f32>, 8>;\n";
+    for (uint32_t p = 0; p < 8; p++) body << "    x[" << p << "] = vec4<f32>(input_a[s * 8u + " << p << "u]);\n";
+    for (uint32_t r = 0; r < R; r++) {
+      body << "    acc" << r << "[0] += ggml_dot(min(first + " << r << "u, uniforms.N - 1u), s, &x);\n";
+    }
+  } else {
+    for (uint32_t r = 0; r < R; r++) {
+      body << "    let w" << r << " = ggml_sub(min(first + " << r << "u, uniforms.N - 1u), s);\n";
+    }
+    body << "    for (var m = 0u; m < M; m++) {\n"
+         << "      let i = (m * uniforms.steps + s) * 8u;\n";
+    for (uint32_t p = 0; p < 8; p++) body << "      let x" << p << " = vec4<f32>(input_a[i + " << p << "u]);\n";
+    for (uint32_t r = 0; r < R; r++) {
+      body << "      acc" << r << "[m] += ";
+      for (uint32_t p = 0; p < 8; p++) body << (p ? " + " : "") << "dot(x" << p << ", w" << r << "[" << p << "])";
+      body << ";\n";
+    }
+    body << "    }\n";
+  }
+  body << "  }\n";
+  for (uint32_t r = 0; r < R; r++) {
+    body << "  {\n"
+         << "    let row = first + " << r << "u;\n"
+         << "    for (var m = 0u; m < M; m++) {\n";
+    if (use_subgroups_) {
+      // Subgroups of exactly 32 lanes (checked on the host): a team is a subgroup.
+      body << "      let total = subgroupAdd(acc" << r << "[m]);\n";
+    } else {
+      body << "      partial[local_idx] = acc" << r << "[m];\n"
+           << "      workgroupBarrier();\n"
+           << "      for (var stride = 16u; stride > 0u; stride = stride / 2u) {\n"
+           << "        if (lane < stride) { partial[local_idx] += partial[local_idx + stride]; }\n"
+           << "        workgroupBarrier();\n"
+           << "      }\n"
+           << "      let total = partial[local_idx - lane];\n"
+           << "      workgroupBarrier();\n";
+    }
+    body << "      if (lane == 0u && row < uniforms.N) { output[m * uniforms.N + row] = output_element_t(total); }\n"
+         << "    }\n"
+         << "  }\n";
+  }
+  return Status::OK();
+}
+
+Status MatMulGgmlTileProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("input_a", ShaderUsage::UseValueTypeAlias | ShaderUsage::UseElementTypeAlias);
+  AddWeightInputs(shader, type_);
+  shader.AddOutput("output", ShaderUsage::UseElementTypeAlias);
+  // One sub-block of 32 weights of K per step. Tiles by vec4 along K, in A's type: tile_w[p * 128 + n],
+  // tile_a[p * 64 + m] (adjacent lanes read adjacent elements).
+  shader.AdditionalImplementation()
+      << "var<workgroup> tile_w: array<vec4<input_a_element_t>, " << kTileN * 8 << ">;\n"
+      << "var<workgroup> tile_a: array<vec4<input_a_element_t>, " << kTileM * 8 << ">;\n";
+  auto& body = shader.MainFunctionBody();
+  // 256 lanes: the first 128 decode a row's sub-block of W each, the rest load A; then each lane sums 8 x 4 outputs:
+  // rows of W n0 + 16i, rows of A m0 + 16j (float32 sums).
+  body << "  let tile_n = (workgroup_idx % uniforms.n_tiles) * " << kTileN << "u;\n"
+       << "  let tile_m = (workgroup_idx / uniforms.n_tiles) * " << kTileM << "u;\n"
+       << "  let n0 = local_idx % 16u;\n"
+       << "  let m0 = local_idx / 16u;\n"
+       << "  var acc: array<vec4<f32>, 8>;\n"
+       << "  for (var s = 0u; s < uniforms.steps; s++) {\n"
+       << "    if (local_idx < " << kTileN << "u) {\n"
+       << "      let w = ggml_sub(min(tile_n + local_idx, uniforms.N - 1u), s);\n";
+  for (uint32_t p = 0; p < 8; p++) {
+    body << "      tile_w[" << p * kTileN << "u + local_idx] = vec4<input_a_element_t>(w[" << p << "]);\n";
+  }
+  body << "    } else {\n"
+       << "      for (var e = local_idx - " << kTileN << "u; e < " << kTileM * 8 << "u; e += " << 256 - kTileN << "u) {\n"
+       << "        let p = e % 8u;\n"
+       << "        let m = e / 8u;\n"
+       << "        let gm = tile_m + m;\n"
+       << "        let a = input_a[(min(gm, uniforms.M - 1u) * uniforms.steps + s) * 8u + p];\n"
+       << "        tile_a[p * " << kTileM << "u + m] = select(input_a_value_t(0.0), a, gm < uniforms.M);\n"
+       << "      }\n"
+       << "    }\n"
+       << "    workgroupBarrier();\n"
+       << "    for (var p = 0u; p < 8u; p++) {\n";
+  for (uint32_t j = 0; j < 4; j++) body << "      let a" << j << " = vec4<f32>(tile_a[p * " << kTileM << "u + m0 + " << 16 * j << "u]);\n";
+  for (uint32_t i = 0; i < 8; i++) {
+    body << "      { let w = vec4<f32>(tile_w[p * " << kTileN << "u + n0 + " << 16 * i << "u]);\n"
+         << "        acc[" << i << "] += vec4<f32>(dot(a0, w), dot(a1, w), dot(a2, w), dot(a3, w)); }\n";
+  }
+  body << "    }\n"
+       << "    workgroupBarrier();\n"
+       << "  }\n";
+  for (uint32_t i = 0; i < 8; i++) {
+    for (uint32_t j = 0; j < 4; j++) {
+      body << "  { let m = tile_m + m0 + " << 16 * j << "u; let n = tile_n + n0 + " << 16 * i << "u;\n"
+           << "    if (m < uniforms.M && n < uniforms.N) { output[m * uniforms.N + n] = output_element_t(acc[" << i << "][" << j << "]); } }\n";
+    }
+  }
+  return Status::OK();
+}
+
+Status GatherGgmlProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("indices");
+  AddWeightInputs(shader, type_);
+  shader.AddOutput("output", ShaderUsage::UseValueTypeAlias);
+  shader.MainFunctionBody()
+      << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.count")
+      << "  let token = global_idx / uniforms.steps;\n"
+      << "  let s = global_idx % uniforms.steps;\n"
+      << "  let row = u32(clamp(indices[token], 0, i32(uniforms.N) - 1));\n"
+      << "  let w = ggml_sub(row, s);\n";
+  for (uint32_t p = 0; p < 8; p++) {
+    shader.MainFunctionBody() << "  output[global_idx * 8u + " << p << "u] = output_value_t(w[" << p << "]);\n";
+  }
+  return Status::OK();
+}
+
+ONNX_OPERATOR_KERNEL_EX(
+    MatMulGgml,
+    kMSDomain,
+    1,
+    kWebGpuExecutionProvider,
+    (*KernelDefBuilder::Create())
+        .TypeConstraint("T1", WebGpuSupportedFloatTypes())
+        .TypeConstraint("T2", DataTypeImpl::GetTensorType<uint8_t>()),
+    MatMulGgml);
+
+ONNX_OPERATOR_KERNEL_EX(
+    GatherGgml,
+    kMSDomain,
+    1,
+    kWebGpuExecutionProvider,
+    (*KernelDefBuilder::Create())
+        .TypeConstraint("T1", DataTypeImpl::GetTensorType<MLFloat16>())
+        .TypeConstraint("T2", DataTypeImpl::GetTensorType<uint8_t>())
+        .TypeConstraint("Tind", DataTypeImpl::GetTensorType<int32_t>()),
+    GatherGgml);
+
+MatMulGgml::MatMulGgml(const OpKernelInfo& info) : WebGpuKernel(info) {
+  K_ = info.GetAttr<int64_t>("K");
+  N_ = info.GetAttr<int64_t>("N");
+  ORT_THROW_IF_ERROR(ReadType(info, &type_));
+  ORT_ENFORCE(K_ % kSuperblock == 0, "MatMulGgml: K must be a multiple of 256.");
+}
+
+Status MatMulGgml::ComputeInternal(onnxruntime::webgpu::ComputeContext& context) const {
+  const Tensor* a = context.Input(0);
+  const Tensor* b = context.Input(1);
+  const Tensor* grid = context.Input(2);
+  Layout layout;
+  ORT_RETURN_IF_ERROR(GetLayout(type_, &layout));
+  ORT_RETURN_IF(layout.grid_words && grid == nullptr, "MatMulGgml: this type needs its grid input.");
+  const uint32_t K = onnxruntime::narrow<uint32_t>(K_);
+  const uint32_t N = onnxruntime::narrow<uint32_t>(N_);
+  const uint32_t row_words = RowWords(layout, K);
+  ORT_RETURN_IF(b->Shape().Size() != static_cast<int64_t>(N) * row_words * 4, "MatMulGgml: B has ", b->Shape().Size(),
+                " bytes, expected ", static_cast<int64_t>(N) * row_words * 4);
+
+  MatMulComputeHelper helper;
+  ORT_RETURN_IF_ERROR(helper.Compute(a->Shape(), TensorShape({N_, K_}), false, true));
+  Tensor* y = context.Output(0, helper.OutputShape());
+  if (y->Shape().Size() == 0) {
+    return Status::OK();
+  }
+  const uint32_t M = onnxruntime::narrow<uint32_t>(a->Shape().SizeToDimension(a->Shape().NumDimensions() - 1));
+  const uint32_t superblocks = K / kSuperblock;
+
+  auto add_weights = [&](auto& program) {
+    program.AddInput({b, ProgramTensorMetadataDependency::TypeAndRank, 4});
+    if (layout.grid_words) {
+      program.AddInput({grid, ProgramTensorMetadataDependency::TypeAndRank, type_ == GgmlType::IQ2_S ? 16 : type_ == GgmlType::IQ3_S ? 8 : 4});
+    }
+  };
+  if (M <= kGgmlDecodeMaxRows) {
+    const bool use_subgroups = context.HasFeature(wgpu::FeatureName::Subgroups) &&
+                               context.AdapterInfo().subgroupMinSize == 32 && context.AdapterInfo().subgroupMaxSize == 32;
+    MatMulGgmlDecodeProgram program{type_, M, use_subgroups};
+    program.SetWorkgroupSize(kDecodeTeams * 32);
+    program.SetDispatchGroupSize(CeilDiv(N, kDecodeTeams * DecodeRowsPerTeam(M)));
+    program.AddInput({a, ProgramTensorMetadataDependency::TypeAndRank, 4});
+    add_weights(program);
+    program.AddOutput({y, ProgramTensorMetadataDependency::TypeAndRank});
+    program.AddUniformVariables({{N}, {K / 32}, {row_words}, {superblocks}});
+    program.CacheHint(static_cast<int64_t>(type_), M, use_subgroups);
+    return context.RunProgram(program);
+  }
+  const uint32_t n_tiles = CeilDiv(N, kTileN);
+  MatMulGgmlTileProgram program{type_};
+  program.SetWorkgroupSize(256);
+  program.SetDispatchGroupSize(n_tiles * CeilDiv(M, kTileM));
+  program.AddInput({a, ProgramTensorMetadataDependency::TypeAndRank, 4});
+  add_weights(program);
+  program.AddOutput({y, ProgramTensorMetadataDependency::TypeAndRank});
+  program.AddUniformVariables({{M}, {N}, {K / 32}, {row_words}, {superblocks}, {n_tiles}});
+  program.CacheHint(static_cast<int64_t>(type_));
+  return context.RunProgram(program);
+}
+
+GatherGgml::GatherGgml(const OpKernelInfo& info) : WebGpuKernel(info) {
+  K_ = info.GetAttr<int64_t>("K");
+  ORT_THROW_IF_ERROR(ReadType(info, &type_));
+  ORT_ENFORCE(K_ % kSuperblock == 0, "GatherGgml: K must be a multiple of 256.");
+}
+
+Status GatherGgml::ComputeInternal(onnxruntime::webgpu::ComputeContext& context) const {
+  const Tensor* data = context.Input(0);
+  const Tensor* indices = context.Input(1);
+  const Tensor* grid = context.Input(2);
+  Layout layout;
+  ORT_RETURN_IF_ERROR(GetLayout(type_, &layout));
+  ORT_RETURN_IF(layout.grid_words && grid == nullptr, "GatherGgml: this type needs its grid input.");
+  const uint32_t K = onnxruntime::narrow<uint32_t>(K_);
+  const uint32_t row_words = RowWords(layout, K);
+  ORT_RETURN_IF(data->Shape().NumDimensions() != 2 || data->Shape()[1] != static_cast<int64_t>(row_words) * 4,
+                "GatherGgml: data must be [rows, ", row_words * 4, "] bytes.");
+  const uint32_t rows = onnxruntime::narrow<uint32_t>(data->Shape()[0]);
+
+  TensorShapeVector dims = indices->Shape().AsShapeVector();
+  dims.push_back(K_);
+  Tensor* y = context.Output(0, TensorShape(dims));
+  const uint32_t count = onnxruntime::narrow<uint32_t>(indices->Shape().Size()) * (K / 32);
+  if (count == 0) {
+    return Status::OK();
+  }
+  GatherGgmlProgram program{type_};
+  program.AddInput({indices, ProgramTensorMetadataDependency::TypeAndRank});
+  program.AddInput({data, ProgramTensorMetadataDependency::TypeAndRank, 4});
+  if (layout.grid_words) {
+    program.AddInput({grid, ProgramTensorMetadataDependency::TypeAndRank, type_ == GgmlType::IQ2_S ? 16 : type_ == GgmlType::IQ3_S ? 8 : 4});
+  }
+  program.AddOutput({y, ProgramTensorMetadataDependency::TypeAndRank, 4});
+  program.SetWorkgroupSize(64);
+  program.SetDispatchGroupSize(CeilDiv(count, 64u));
+  program.AddUniformVariables({{count}, {rows}, {K / 32}, {row_words}, {K / kSuperblock}});
+  program.CacheHint(static_cast<int64_t>(type_));
+  return context.RunProgram(program);
+}
