+// Each team of 32 lanes computes one output row for one row of A (decoding), or four output rows for up to 8 rows of
+// A (checking a few guessed tokens at once). A lane takes a step of 32 weights (four words) of each of its rows,
+// striding along K, and walks it a word at a time: codes go to f16 two per word operation (0x6400 | code is the f16
+// value 1024 + code, so one subtraction gives q - 8 exactly) and are scaled, each value of A loaded is used for all of
+// the lane's rows, and a step's products are summed in f16 (f32 for f32 models) into f32 totals, reduced with
+// subgroupAdd where subgroups are 32 lanes, else through workgroup memory. Four rows of A cost little more than one: the weights dominate.
+// With zero points (4-bit, one per block, packed eight to a word as MatMulNBits stores them), a step subtracts
+// 1024 + its block's zero point instead of 1032.
+class MatMulNBitsQ4DecodeProgram final : public Program<MatMulNBitsQ4DecodeProgram> {
+ public:
+  MatMulNBitsQ4DecodeProgram(bool has_bias, bool use_subgroups, uint32_t rows, uint32_t rows_per_team, bool gated, bool f16, bool has_zero_points)
+      : Program{"MatMulNBitsQ4Decode"}, has_bias_{has_bias}, use_subgroups_{use_subgroups}, rows_{rows}, rows_per_team_{rows_per_team}, gated_{gated}, f16_{f16}, has_zero_points_{has_zero_points} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"N", ProgramUniformVariableDataType::Uint32},
+                                          {"steps", ProgramUniformVariableDataType::Uint32},
+                                          {"blocks_per_col", ProgramUniformVariableDataType::Uint32},
+                                          {"steps_per_block", ProgramUniformVariableDataType::Uint32},
+                                          {"zero_blocks_per_col", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  bool has_bias_;
+  bool use_subgroups_;
+  uint32_t rows_;           // rows of A
+  uint32_t rows_per_team_;  // rows of W per team of 32 lanes (of each of gate and up when gated)
+  bool gated_;              // silu(A x gate) * (A x up): a gated MLP's first half
+  bool f16_;                // f16 activations (f32 ones are multiplied in f32)
+  bool has_zero_points_;    // 4-bit zero points per block (else 8)
+};
+
+bool CanApplyMatMulNBitsQ4Decode(uint32_t nbits, bool has_zero_points, bool has_weight_idx, bool single_scale_weights,
+                                 uint32_t block_size, uint32_t K, uint32_t batch_count, uint32_t M);
+
+Status ApplyMatMulNBitsQ4Decode(const Tensor* a, const Tensor* b, const Tensor* scales, const Tensor* zero_points, const Tensor* bias,
+                                uint32_t M, uint32_t N, uint32_t K, uint32_t block_size,
+                                onnxruntime::webgpu::ComputeContext& context, Tensor* y);
+
+// silu(a x gate) * (a x up), for MatMulNBitsMlp: same conditions as above, no biases.
+Status ApplyMatMulNBitsQ4DecodeGated(const Tensor* a, const Tensor* gate_b, const Tensor* gate_scales,
+                                     const Tensor* up_b, const Tensor* up_scales, uint32_t M, uint32_t N, uint32_t K,
+                                     uint32_t block_size, onnxruntime::webgpu::ComputeContext& context, Tensor* y);
+
