+// Quick Inference patch: MatMulGgml and GatherGgml, matrices in llama.cpp's calibrated quantization types (IQ2_S,
+// IQ3_S, IQ4_XS, Q3_K, Q4_K, Q5_K, Q6_K) with their blocks re-laid out for word-aligned reads, unchanged otherwise.
+//
+// A row of K weights is K / 256 records of R words (one per superblock of 256 weights), then A float16 values per
+// superblock (its d, and dmin or IQ4_XS's high scale bits). Inside a record each sub-block of 32 weights has its codes
+// in words of its own, weight i at bit (i * bits) % 32 of word (i * bits) / 32; per-sub-block scales keep llama.cpp's
+// packing. tools/export/ggml_pack.py in Quick Inference writes the layout and decodes it as these shaders do.
+
+#pragma once
+
+#include "core/providers/webgpu/program.h"
+#include "core/providers/webgpu/webgpu_kernel.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+using namespace onnxruntime::webgpu;
+
+// ggml's type ids.
+enum class GgmlType : int64_t {
+  Q3_K = 11,
+  Q4_K = 12,
+  Q5_K = 13,
+  Q6_K = 14,
+  IQ3_S = 21,
+  IQ2_S = 22,
+  IQ4_XS = 23,
+};
+
+// Rows of A up to which MatMulGgml uses its decode program (more go to the tiled one).
+constexpr uint32_t kGgmlDecodeMaxRows = 8;
+
+// Teams of 32 lanes take 2 rows of W each; every lane decodes one sub-block of 32 weights of both rows per step and
+// uses them for all M rows of A.
+class MatMulGgmlDecodeProgram final : public Program<MatMulGgmlDecodeProgram> {
+ public:
+  MatMulGgmlDecodeProgram(GgmlType type, uint32_t rows, bool use_subgroups)
+      : Program{"MatMulGgmlDecode"}, type_{type}, rows_{rows}, use_subgroups_{use_subgroups} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"N", ProgramUniformVariableDataType::Uint32},
+                                          {"steps", ProgramUniformVariableDataType::Uint32},
+                                          {"row_words", ProgramUniformVariableDataType::Uint32},
+                                          {"superblocks", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  GgmlType type_;
+  uint32_t rows_;
+  bool use_subgroups_;
+};
+
+// Output tiles of 128 rows of W by 64 rows of A, 32 weights of K at a time through workgroup memory.
+class MatMulGgmlTileProgram final : public Program<MatMulGgmlTileProgram> {
+ public:
+  explicit MatMulGgmlTileProgram(GgmlType type) : Program{"MatMulGgmlTile"}, type_{type} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"M", ProgramUniformVariableDataType::Uint32},
+                                          {"N", ProgramUniformVariableDataType::Uint32},
+                                          {"steps", ProgramUniformVariableDataType::Uint32},
+                                          {"row_words", ProgramUniformVariableDataType::Uint32},
+                                          {"superblocks", ProgramUniformVariableDataType::Uint32},
+                                          {"n_tiles", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  GgmlType type_;
+};
+
+// One invocation per sub-block of 32 weights of an output row.
+class GatherGgmlProgram final : public Program<GatherGgmlProgram> {
+ public:
+  explicit GatherGgmlProgram(GgmlType type) : Program{"GatherGgml"}, type_{type} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"count", ProgramUniformVariableDataType::Uint32},
+                                          {"N", ProgramUniformVariableDataType::Uint32},
+                                          {"steps", ProgramUniformVariableDataType::Uint32},
+                                          {"row_words", ProgramUniformVariableDataType::Uint32},
+                                          {"superblocks", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  GgmlType type_;
+};
+
+class MatMulGgml final : public WebGpuKernel {
+ public:
+  MatMulGgml(const OpKernelInfo& info);
+  Status ComputeInternal(onnxruntime::webgpu::ComputeContext& context) const override;
+
+ private:
+  int64_t K_;
+  int64_t N_;
+  GgmlType type_;
+};
+
+class GatherGgml final : public WebGpuKernel {
+ public:
+  GatherGgml(const OpKernelInfo& info);
+  Status ComputeInternal(onnxruntime::webgpu::ComputeContext& context) const override;
+
+ private:
+  int64_t K_;
+  GgmlType type_;
+};
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
