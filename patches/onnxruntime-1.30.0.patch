+namespace {
+
+constexpr uint32_t kSuperblock = 256;
+constexpr uint32_t kDecodeTeams = 4;
+// Rows of W per team: one row of A gets more (its 32 values of a step stay in registers for all of them).
+uint32_t DecodeRowsPerTeam(uint32_t M) { return M == 1 ? 4 : 2; }
+constexpr uint32_t kTileN = 128;
+constexpr uint32_t kTileM = 64;
+
+struct Layout {
+  uint32_t record_words;
+  uint32_t aux_halves;
+  // Words of the type's grid input (0: no grid).
+  uint32_t grid_words;
+};
+
+Status GetLayout(GgmlType type, Layout* layout) {
+  switch (type) {
+    case GgmlType::Q3_K: *layout = {27, 1, 0}; break;
+    case GgmlType::Q4_K: *layout = {35, 2, 0}; break;
+    case GgmlType::Q5_K: *layout = {43, 2, 0}; break;
+    case GgmlType::Q6_K: *layout = {52, 1, 0}; break;
+    case GgmlType::IQ2_S: *layout = {20, 1, 4096}; break;
+    case GgmlType::IQ3_S: *layout = {27, 1, 1024}; break;
+    case GgmlType::IQ4_XS: *layout = {33, 2, 16}; break;
+    default:
+      return ORT_MAKE_STATUS(ONNXRUNTIME, INVALID_ARGUMENT, "ggml type ", static_cast<int64_t>(type), " is not supported.");
+  }
+  return Status::OK();
+}
+
+uint32_t RowWords(const Layout& layout, uint32_t K) {
+  const uint32_t superblocks = K / kSuperblock;
+  return superblocks * layout.record_words + (superblocks * layout.aux_halves + 1) / 2;
+}
+
+// The WGSL of one type's sub-block of 32 weights: `pre` (statements reading the sub-block's codes and scales), each
+// vec4 part's unscaled values and the index of its scale in `scales`, and an offset subtracted from every weight
+// (K types' dmin * min).
+struct SubBlock {
+  std::string pre;
+  std::vector<std::string> scales;
+  std::vector<std::pair<std::string, uint32_t>> parts;
+  std::string offset;
+};
+
+SubBlock SubBlockCode(GgmlType type) {
+  SubBlock b;
+  std::ostringstream c;
+  auto part = [&](const std::string& value, uint32_t scale) { b.parts.emplace_back(value, scale); };
+  switch (type) {
+    case GgmlType::Q4_K:
+    case GgmlType::Q5_K: {
+      const bool q5 = type == GgmlType::Q5_K;
+      c << "  let dmin = ggml_half(aux + 1u);\n"
+        << "  var sc: u32;\n"
+        << "  var mn: u32;\n"
+        << "  if (j < 4u) {\n"
+        << "    sc = ggml_byte(rec, j) & 63u;\n"
+        << "    mn = ggml_byte(rec, j + 4u) & 63u;\n"
+        << "  } else {\n"
+        << "    sc = (ggml_byte(rec, j + 4u) & 15u) | ((ggml_byte(rec, j - 4u) >> 6u) << 4u);\n"
+        << "    mn = (ggml_byte(rec, j + 4u) >> 4u) | ((ggml_byte(rec, j) >> 6u) << 4u);\n"
+        << "  }\n"
+        << "  let scale = d * f32(sc);\n"
+        << "  let off = dmin * f32(mn);\n"
+        << "  let base = rec + 3u + j * " << (q5 ? 5 : 4) << "u;\n";
+      if (q5) c << "  let high = input_b[base + 4u];\n";
+      b.scales = {"scale"};
+      b.offset = "off";
+      for (uint32_t p = 0; p < 8; p++) {
+        part("vec4<f32>(bits4(input_b[base + " + std::to_string(p / 2) + "u], " + std::to_string(16 * (p % 2)) + "u)" +
+                 (q5 ? " | (bits1(high, " + std::to_string(4 * p) + "u) << vec4<u32>(4u))" : "") + ")",
+             0);
+      }
+      break;
+    }
+    case GgmlType::Q6_K:
+      c << "  let base = rec + j * 6u;\n"
+        << "  let scale0 = d * f32(bitcast<i32>(ggml_byte(rec + 48u, 2u * j) << 24u) >> 24u);\n"
+        << "  let scale1 = d * f32(bitcast<i32>(ggml_byte(rec + 48u, 2u * j + 1u) << 24u) >> 24u);\n";
+      b.scales = {"scale0", "scale1"};
+      for (uint32_t p = 0; p < 8; p++) {
+        part("(vec4<f32>(bits4(input_b[base + " + std::to_string(p / 2) + "u], " + std::to_string(16 * (p % 2)) +
+                 "u) | (bits2(input_b[base + " + std::to_string(4 + p / 4) + "u], " + std::to_string(8 * (p % 4)) +
+                 "u) << vec4<u32>(4u))) - vec4<f32>(32.0))",
+             p / 4);
+      }
+      break;
+    case GgmlType::Q3_K:
+      c << "  let base = rec + j * 3u;\n";
+      for (uint32_t h = 0; h < 2; h++) {
+        // Scale of 16-weight group g = 2j + h: low 4 bits from byte g % 8 (nibble g / 8), high 2 from byte 8 + g % 4.
+        c << "  let g" << h << " = 2u * j + " << h << "u;\n"
+          << "  let scale" << h << " = d * f32(i32(((ggml_byte(rec + 24u, g" << h << " % 8u) >> (4u * (g" << h << " / 8u))) & 15u) | "
+          << "(((ggml_byte(rec + 24u, 8u + g" << h << " % 4u) >> (2u * (g" << h << " / 4u))) & 3u) << 4u)) - 32);\n";
+      }
+      c << "  let high = input_b[base + 2u];\n";
+      b.scales = {"scale0", "scale1"};
+      for (uint32_t p = 0; p < 8; p++) {
+        part("(vec4<f32>(bits2(input_b[base + " + std::to_string(p / 4) + "u], " + std::to_string(8 * (p % 4)) +
+                 "u) | (bits1(high, " + std::to_string(4 * p) + "u) << vec4<u32>(2u))) - vec4<f32>(4.0))",
+             p / 4);
+      }
+      break;
+    case GgmlType::IQ4_XS:
+      c << "  let low = (ggml_byte(rec, j / 2u) >> (4u * (j % 2u))) & 15u;\n"
+        << "  let high = (ggml_half_bits(aux + 1u) >> (2u * j)) & 3u;\n"
+        << "  let scale = d * f32(i32(low | (high << 4u)) - 32);\n"
+        << "  let base = rec + 1u + j * 4u;\n";
+      b.scales = {"scale"};
+      for (uint32_t p = 0; p < 8; p++) {
+        const std::string q = "q" + std::to_string(p);
+        c << "  let " << q << " = bits4(input_b[base + " << p / 2 << "u], " << 16 * (p % 2) << "u);\n";
+        part("bitcast<vec4<f32>>(vec4<u32>(grid[" + q + ".x], grid[" + q + ".y], grid[" + q + ".z], grid[" + q + ".w]))", 0);
+      }
+      break;
+    case GgmlType::IQ2_S:
+      // 8-weight vectors: index qs | 2 bits of qh << 8, one sign bit per weight; scales per 16 weights.
+      c << "  let qs = input_b[rec + 2u * j];\n"
+        << "  let signs = input_b[rec + 2u * j + 1u];\n"
+        << "  let qh = ggml_byte(rec + 16u, j);\n"
+        << "  let sc = ggml_byte(rec + 18u, j);\n"
+        << "  let scale0 = d * (0.5 + f32(sc & 15u)) * 0.25;\n"
+        << "  let scale1 = d * (0.5 + f32(sc >> 4u)) * 0.25;\n";
+      b.scales = {"scale0", "scale1"};
+      for (uint32_t g = 0; g < 4; g++) {
+        const std::string code = "code" + std::to_string(g);
+        c << "  let " << code << " = grid[((qs >> " << 8 * g << "u) & 255u) | (((qh >> " << 2 * g << "u) & 3u) << 8u)];\n";
+        const std::string sign = "(signs >> " + std::to_string(8 * g) + "u)";
+        part("signed(iq2s(" + code + ", 0u), " + sign + ")", g / 2);
+        part("signed(iq2s(" + code + ", 1u), " + sign + " >> 4u)", g / 2);
+      }
+      break;
+    case GgmlType::IQ3_S:
+      // 4-weight vectors: index qs | 1 bit of qh << 8, one sign bit per weight; one scale per sub-block.
+      c << "  let base = rec + 3u * j;\n"
+        << "  let qs0 = input_b[base];\n"
+        << "  let qs1 = input_b[base + 1u];\n"
+        << "  let signs = input_b[base + 2u];\n"
+        << "  let qh = ggml_byte(rec + 24u, j);\n"
+        << "  let scale = d * f32(1u + 2u * ((ggml_byte(rec + 26u, j / 2u) >> (4u * (j % 2u))) & 15u));\n";
+      b.scales = {"scale"};
+      for (uint32_t p = 0; p < 8; p++) {
+        part("signed(iq3s(grid[((qs" + std::to_string(p / 4) + " >> " + std::to_string(8 * (p % 4)) + "u) & 255u) | (((qh >> " +
+                 std::to_string(p) + "u) & 1u) << 8u)]), signs >> " + std::to_string(4 * p) + "u)",
+             0);
+      }
+      break;
+  }
+  b.pre = c.str();
+  return b;
+}
+
+// WGSL for ggml_sub(row, s), the 32 weights of sub-block s of row `row` as 8 vec4 (weights 4p..4p+3 in element p),
+// and ggml_dot(row, s, x), their dot product with x's 32 values, each scale applied once to its part of the sum. Reads
+// `input_b` (the layout, as u32) and, for IQ types, `grid` (IQ2_S's and IQ3_S's vectors of magnitudes as float16,
+// IQ4_XS's 16 values as float32 bits).
+std::string SubBlockFunctions(GgmlType type) {
+  Layout layout;
+  ORT_THROW_IF_ERROR(GetLayout(type, &layout));
+  const SubBlock b = SubBlockCode(type);
+  std::ostringstream c;
+  c << "fn ggml_half(h: u32) -> f32 { return unpack2x16float(input_b[h >> 1u])[h & 1u]; }\n"
+    << "fn ggml_half_bits(h: u32) -> u32 { return (input_b[h >> 1u] >> ((h & 1u) * 16u)) & 0xffffu; }\n"
+    << "fn ggml_byte(w: u32, b: u32) -> u32 { return (input_b[w + (b >> 2u)] >> ((b & 3u) * 8u)) & 0xffu; }\n"
+    << "fn bits4(word: u32, shift: u32) -> vec4<u32> { return (vec4<u32>(word) >> (vec4<u32>(0u, 4u, 8u, 12u) + vec4<u32>(shift))) & vec4<u32>(15u); }\n"
+    << "fn bits2(word: u32, shift: u32) -> vec4<u32> { return (vec4<u32>(word) >> (vec4<u32>(0u, 2u, 4u, 6u) + vec4<u32>(shift))) & vec4<u32>(3u); }\n"
+    << "fn bits1(word: u32, shift: u32) -> vec4<u32> { return (vec4<u32>(word) >> (vec4<u32>(0u, 1u, 2u, 3u) + vec4<u32>(shift))) & vec4<u32>(1u); }\n"
+    // Bit i of `bits` (i = 0..3) becomes the sign of element i: moved to bit 31 and XOR-ed into the float.
+    // IQ2_S's grid entry: 8 float16 magnitudes in a vec4<u32>; `second` (0 or 1) picks 4 of them.
+    << "fn iq2s(v: vec4<u32>, second: u32) -> vec4<f32> { return vec4<f32>(unpack2x16float(v[2u * second]), unpack2x16float(v[2u * second + 1u])); }\n"
+    << "fn iq3s(v: vec2<u32>) -> vec4<f32> { return vec4<f32>(unpack2x16float(v.x), unpack2x16float(v.y)); }\n"
+    << "fn signed(m: vec4<f32>, bits: u32) -> vec4<f32> {\n"
+    << "  return bitcast<vec4<f32>>(bitcast<vec4<u32>>(m) ^ ((vec4<u32>(bits) << vec4<u32>(31u, 30u, 29u, 28u)) & vec4<u32>(0x80000000u)));\n"
+    << "}\n";
+  const std::string prologue =
+      "  let sb = s / 8u;\n"
+      "  let j = s % 8u;\n"
+      "  let rec = row * uniforms.row_words + sb * " + std::to_string(layout.record_words) + "u;\n"
+      "  let aux = (row * uniforms.row_words + uniforms.superblocks * " + std::to_string(layout.record_words) + "u) * 2u + sb * " +
+      std::to_string(layout.aux_halves) + "u;\n" +
+      "  let d = ggml_half(aux);\n";
+  c << "fn ggml_sub(row: u32, s: u32) -> array<vec4<f32>, 8> {\n"
+    << prologue << b.pre << "  var w: array<vec4<f32>, 8>;\n";
+  for (size_t p = 0; p < b.parts.size(); p++) {
+    c << "  w[" << p << "] = " << b.scales[b.parts[p].second] << " * " << b.parts[p].first;
+    if (!b.offset.empty()) c << " - vec4<f32>(" << b.offset << ")";
+    c << ";\n";
+  }
+  c << "  return w;\n"
+    << "}\n";
+  c << "fn ggml_dot(row: u32, s: u32, x: ptr<function, array<vec4<f32>, 8>>) -> f32 {\n"
+    << prologue << b.pre << "  var total = 0.0;\n";
+  for (size_t k = 0; k < b.scales.size(); k++) {
+    c << "  total += " << b.scales[k] << " * (";
+    bool first = true;
+    for (size_t p = 0; p < b.parts.size(); p++) {
+      if (b.parts[p].second != k) continue;
+      c << (first ? "" : " + ") << "dot((*x)[" << p << "], " << b.parts[p].first << ")";
+      first = false;
+    }
+    c << ");\n";
+  }
+  if (!b.offset.empty()) {
+    c << "  total -= " << b.offset << " * (";
+    for (size_t p = 0; p < b.parts.size(); p++) c << (p ? " + " : "") << "dot((*x)[" << p << "], vec4<f32>(1.0))";
+    c << ");\n";
+  }
+  c << "  return total;\n"
+    << "}\n";
+  return c.str();
+}
+
+// With `shared_grid`, the grid is copied into workgroup memory (`grid`; the input is `grid_in`), where its random
+// lookups are cheaper than from a storage buffer; the program's main function calls load_grid first.
+void AddWeightInputs(ShaderHelper& shader, GgmlType type, bool shared_grid = false) {
+  Layout layout;
+  ORT_THROW_IF_ERROR(GetLayout(type, &layout));
+  shader.AddInput("input_b");
+  // IQ2_S's and IQ3_S's grids (float16 magnitudes) stay in their storage buffers.
+  const bool copy = shared_grid && layout.grid_words && type != GgmlType::IQ2_S && type != GgmlType::IQ3_S;
+  if (layout.grid_words) {
+    shader.AddInput(copy ? "grid_in" : "grid");
+  }
+  if (shared_grid) {
+    shader.AdditionalImplementation() << "fn load_grid(local: u32, threads: u32) {\n";
+    if (copy) {
+      shader.AdditionalImplementation()
+          << "  for (var i = local; i < " << layout.grid_words << "u; i += threads) { grid[i] = grid_in[i]; }\n"
+          << "  workgroupBarrier();\n";
+    }
+    shader.AdditionalImplementation() << "}\n";
+  }
+  if (copy) {
+    shader.AdditionalImplementation() << "var<workgroup> grid: array<u32, " << layout.grid_words << ">;\n";
+  }
+  shader.AdditionalImplementation() << SubBlockFunctions(type);
+}
+
+Status ReadType(const OpKernelInfo& info, GgmlType* type) {
+  *type = static_cast<GgmlType>(info.GetAttr<int64_t>("ggml_type"));
+  Layout layout;
+  return GetLayout(*type, &layout);
+}
