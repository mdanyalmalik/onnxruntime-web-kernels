--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/quantization/matmul_nbits_q2_decode.h
@@ -0,0 +1,45 @@
+// Copyright (c) Quick Inference contributors.
+// Licensed under the MIT License.
+// Quick Inference patch: a faster 2-bit MatMulNBits kernel for few rows of A (decoding).
+
+#pragma once
+
+#include "core/providers/webgpu/program.h"
+#include "core/providers/webgpu/compute_context.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+using namespace onnxruntime::webgpu;
+
+// Each team of 32 lanes computes kQ2DecodeRowsPerTeam output rows; a lane takes 32 weights (two words) of each row
+// per step, keeping its 32 values of A in registers for all of them. Weights are decoded four at a time: byte b of a
+// word holds weights 4b..4b+3, (vec4(byte) >> (0, 2, 4, 6)) & 3 puts them in a vec4<u32>, and OR-ing 0x4b000000 makes
+// floats 2^23 + q, so one subtraction gives q - zero (2) exactly.
+class MatMulNBitsQ2DecodeProgram final : public Program<MatMulNBitsQ2DecodeProgram> {
+ public:
+  MatMulNBitsQ2DecodeProgram(bool has_bias, bool use_subgroups)
+      : Program{"MatMulNBitsQ2Decode"}, has_bias_{has_bias}, use_subgroups_{use_subgroups} {}
+  Status GenerateShaderCode(ShaderHelper& sh) const override;
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"N", ProgramUniformVariableDataType::Uint32},
+                                          {"steps", ProgramUniformVariableDataType::Uint32},
+                                          {"blocks_per_col", ProgramUniformVariableDataType::Uint32},
+                                          {"steps_per_block", ProgramUniformVariableDataType::Uint32},
+                                          {"row_groups", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  bool has_bias_;
+  bool use_subgroups_;
+};
+
+bool CanApplyMatMulNBitsQ2Decode(uint32_t nbits, bool has_zero_points, bool has_weight_idx, bool single_scale_weights,
+                                 uint32_t block_size, uint32_t K, uint32_t batch_count);
+
+Status ApplyMatMulNBitsQ2Decode(const Tensor* a, const Tensor* b, const Tensor* scales, const Tensor* bias,
+                                uint32_t M, uint32_t N, uint32_t K, uint32_t block_size,
+                                onnxruntime::webgpu::ComputeContext& context, Tensor* y);
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
diff --git a/onnxruntime/contrib_ops/webgpu/quantization/matmul_nbits_q4_decode.cc b/onnxruntime/contrib_ops/webgpu/quantization/matmul_nbits_q4_decode.cc
new file mode 100644
index 0000000..e21524b
--- /dev/null
+++ b/onnxruntime/contrib_ops/webgpu/quantization/matmul_nbits_q4_decode.cc
@@ -0,0 +1,212 @@
+// Copyright (c) Quick Inference contributors.
+// Licensed under the MIT License.
+// Quick Inference patch: see matmul_nbits_q4_decode.h.
+
+#include "contrib_ops/webgpu/quantization/matmul_nbits_q4_decode.h"
+
+#include "core/providers/webgpu/shader_helper.h"
+#include "core/providers/webgpu/webgpu_utils.h"
+
+namespace onnxruntime {
+namespace contrib {
+namespace webgpu {
+
+namespace {
+// Teams (rows) per workgroup.
+constexpr uint32_t kQ4DecodeTeams = 4;
+// Rows of W per team when A has several rows: each value of A loaded is used for all of them.
+constexpr uint32_t kQ4DecodeRowsPerTeam = 4;
+}  // namespace
+
+// Most rows of A per dispatch (the rest of a longer A goes to the wide-tile program).
+constexpr uint32_t kQ4DecodeMaxRows = 8;
+
+Status MatMulNBitsQ4DecodeProgram::GenerateShaderCode(ShaderHelper& shader) const {
+  shader.AddInput("input_a", ShaderUsage::UseValueTypeAlias);
+  // Weight matrices: one, or gate and up (gated: the output is silu(gate) * up).
+  const std::vector<std::string> matrices = gated_ ? std::vector<std::string>{"gate", "up"} : std::vector<std::string>{"input"};
+  for (const auto& name : matrices) {
+    shader.AddInput(name + "_b");
+    shader.AddInput(name + "_scales");
+    if (has_zero_points_) {
+      shader.AddInput(name + "_zero_points");
+    }
+  }
+  if (has_bias_) {
+    shader.AddInput("bias");
+  }
+  shader.AddOutput("output", ShaderUsage::UseElementTypeAlias);
+
+  shader.AdditionalImplementation()
+      << "const TEAMS: u32 = " << kQ4DecodeTeams << "u;\n"
+      << "const M: u32 = " << rows_ << "u;\n";
+  if (f16_) {
+    // Codes c and c + 4 of a word shifted by 4c sit in the two halves of (word >> 4c) & 0x000F000F; OR-ing
+    // 0x64006400 makes them the f16 values 1024 + code.
+    shader.AdditionalImplementation()
+        << "fn pair(word: u32, shift: u32) -> vec2<f16> {\n"
+        << "  return bitcast<vec2<f16>>(((word >> shift) & 0x000F000Fu) | 0x64006400u);\n"
+        << "}\n";
+  } else {
+    // Four codes from shifts (0, 4, 8, 12) + base OR-ed into 0x4b000000 are the f32 values 2^23 + code; `offset` is
+    // 2^23 + the zero point.
+    shader.AdditionalImplementation()
+        << "fn quad(word: u32, base: u32, offset: f32) -> vec4<f32> {\n"
+        << "  let codes = (vec4<u32>(word) >> (vec4<u32>(0u, 4u, 8u, 12u) + vec4<u32>(base))) & vec4<u32>(15u);\n"
+        << "  return bitcast<vec4<f32>>(codes | vec4<u32>(0x4b000000u)) - vec4<f32>(offset);\n"
+        << "}\n";
+  }
+  if (!use_subgroups_) {
+    shader.AdditionalImplementation() << "var<workgroup> partial: array<f32, " << kQ4DecodeTeams * 32 << ">;\n";
+  }
+
+  // Weight rows a lane works on, unrolled here (no indexing of register arrays): rows_per_team_ of each matrix.
+  const uint32_t R = rows_per_team_;
+  const uint32_t W = R * static_cast<uint32_t>(matrices.size());
+  auto matrix = [&](uint32_t w) { return matrices[w / R]; };
+  auto row = [&](uint32_t w) { return "min(first + " + std::to_string(w % R) + "u, uniforms.N - 1u)"; };
+
+  auto& body = shader.MainFunctionBody();
+  body << "  let team = local_idx / 32u;\n"
+       << "  let lane = local_idx % 32u;\n"
+       << "  let first = (workgroup_idx * TEAMS + team) * " << R << "u;\n";
+  for (uint32_t w = 0; w < W; w++) body << "  var acc" << w << ": array<f32, M>;\n";
+  body << "  for (var s = lane; s < uniforms.steps; s += 32u) {\n";
+  // A step's products are summed in f16 for f16 models (f32 for f32 ones).
+  const std::string t = f16_ ? "f16" : "f32";
+  // f16: weights are scaled before the products (unscaled codes times large activations, such as an attention sink's
+  // ~2e4, would overflow f16 within a step); f32: the scale is applied to the step's sum.
+  for (uint32_t w = 0; w < W; w++) {
+    body << "    let q" << w << " = " << matrix(w) << "_b[" << row(w) << " * uniforms.steps + s];\n"
+         << "    let scale" << w << " = " << t << "(" << matrix(w) << "_scales[" << row(w) << " * uniforms.blocks_per_col + s / uniforms.steps_per_block]);\n"
+         << "    var part" << w << ": array<" << t << ", M>;\n";
+    // What a code's float value (1024 + code in f16, 2^23 + code in f32) loses to become code - zero point.
+    const std::string base = f16_ ? "1024" : "8388608";
+    if (has_zero_points_) {
+      body << "    let zo" << w << " = " << row(w) << " * uniforms.zero_blocks_per_col + s / uniforms.steps_per_block;\n"
+           << "    let offset" << w << " = " << t << "(" << base << "u + ((" << matrix(w) << "_zero_points[zo" << w << " / 8u] >> ((zo" << w << " % 8u) * 4u)) & 15u));\n";
+    } else {
+      body << "    let offset" << w << " = " << t << "(" << base << "u + 8u);\n";
+    }
+  }
+  body << "    for (var j = 0u; j < 4u; j++) {\n";
+  for (uint32_t w = 0; w < W; w++) {
+    if (f16_) {
+      body << "      let a" << w << " = pair(q" << w << "[j], 0u); let b" << w << " = pair(q" << w << "[j], 4u); "
+           << "let c" << w << " = pair(q" << w << "[j], 8u); let d" << w << " = pair(q" << w << "[j], 12u);\n"
+           << "      let lo" << w << " = (vec4<f16>(a" << w << ".x, b" << w << ".x, c" << w << ".x, d" << w << ".x) - vec4<f16>(offset" << w << ")) * scale" << w << ";\n"
+           << "      let hi" << w << " = (vec4<f16>(a" << w << ".y, b" << w << ".y, c" << w << ".y, d" << w << ".y) - vec4<f16>(offset" << w << ")) * scale" << w << ";\n";
+    } else {
+      body << "      let lo" << w << " = quad(q" << w << "[j], 0u, offset" << w << "); let hi" << w << " = quad(q" << w << "[j], 16u, offset" << w << ");\n";
+    }
+  }
+  body << "      for (var m = 0u; m < M; m++) {\n"
+       << "        let i = (m * uniforms.steps + s) * 8u + j * 2u;\n"
+       << "        let x0 = vec4<" << t << ">(input_a[i]); let x1 = vec4<" << t << ">(input_a[i + 1u]);\n";
+  for (uint32_t w = 0; w < W; w++) body << "        part" << w << "[m] += dot(x0, lo" << w << ") + dot(x1, hi" << w << ");\n";
+  body << "      }\n"
+       << "    }\n";
+  for (uint32_t w = 0; w < W; w++) {
+    body << "    for (var m = 0u; m < M; m++) { acc" << w << "[m] += " << (f16_ ? "f32(part" + std::to_string(w) + "[m])" : "scale" + std::to_string(w) + " * part" + std::to_string(w) + "[m]") << "; }\n";
+  }
+  body << "  }\n";
+
+  // Sums across the team's 32 lanes: subgroups of exactly 32 lanes (checked on the host) are a team.
+  auto reduce = [&](const std::string& value, const std::string& out) {
+    if (use_subgroups_) {
+      body << "      let " << out << " = subgroupAdd(" << value << ");\n";
+    } else {
+      body << "      partial[local_idx] = " << value << ";\n"
+           << "      workgroupBarrier();\n"
+           << "      for (var stride = 16u; stride > 0u; stride = stride / 2u) {\n"
+           << "        if (lane < stride) { partial[local_idx] += partial[local_idx + stride]; }\n"
+           << "        workgroupBarrier();\n"
+           << "      }\n"
+           << "      let " << out << " = partial[local_idx - lane];\n"
+           << "      workgroupBarrier();\n";
+    }
+  };
+  const std::string bias = has_bias_ ? " + f32(bias[row])" : "";
+  for (uint32_t r = 0; r < R; r++) {
+    body << "  {\n"
+         << "    let row = first + " << r << "u;\n"
+         << "    for (var m = 0u; m < M; m++) {\n";
+    reduce("acc" + std::to_string(r) + "[m]", "total");
+    if (gated_) {
+      reduce("acc" + std::to_string(r + R) + "[m]", "up");
+      body << "      if (lane == 0u && row < uniforms.N) { output[m * uniforms.N + row] = output_element_t(total / (1.0 + exp(-total)) * up); }\n";
+    } else {
+      body << "      if (lane == 0u && row < uniforms.N) { output[m * uniforms.N + row] = output_element_t(total" << bias << "); }\n";
+    }
+    body << "    }\n"
+         << "  }\n";
+  }
+  return Status::OK();
+}
+
+bool CanApplyMatMulNBitsQ4Decode(uint32_t nbits, bool has_zero_points, bool has_weight_idx, bool single_scale_weights,
+                                 uint32_t block_size, uint32_t K, uint32_t batch_count, uint32_t M) {
+  // Longer A (prompts) goes to the wide-tile program. Zero points are handled (4-bit, uint8-packed).
+  ORT_UNUSED_PARAMETER(has_zero_points);
+  return nbits == 4 && !has_weight_idx && !single_scale_weights && block_size % 32 == 0 &&
+         K % 32 == 0 && batch_count == 1 && M <= kQ4DecodeMaxRows;
+}
+
+namespace {
+// A matrix's weights, scales and zero points (or null).
+struct Q4Matrix {
+  const Tensor* b;
+  const Tensor* scales;
+  const Tensor* zero_points;
+};
+
+Status RunQ4Decode(const Tensor* a, const std::vector<Q4Matrix>& matrices, const Tensor* bias,
+                   uint32_t M, uint32_t N, uint32_t K, uint32_t block_size, onnxruntime::webgpu::ComputeContext& context,
+                   Tensor* y) {
+  const bool use_subgroups = context.HasFeature(wgpu::FeatureName::Subgroups) &&
+                             context.AdapterInfo().subgroupMinSize == 32 && context.AdapterInfo().subgroupMaxSize == 32;
+  const bool gated = matrices.size() == 2;
+  // One row of A: a row of W per team (more parallel work for the weight reads); more rows of A: each value of A
+  // loaded serves several rows of W (gate and up count as two).
+  const uint32_t rows_per_team = M == 1 ? 1 : (gated ? kQ4DecodeRowsPerTeam / 2 : kQ4DecodeRowsPerTeam);
+  const uint32_t row_groups = CeilDiv(N, kQ4DecodeTeams * rows_per_team);
+  const bool f16 = a->DataType() == DataTypeImpl::GetType<MLFloat16>();
+  const bool has_zero_points = matrices[0].zero_points != nullptr;
+  MatMulNBitsQ4DecodeProgram program{bias != nullptr, use_subgroups, M, rows_per_team, gated, f16, has_zero_points};
+  program.SetWorkgroupSize(kQ4DecodeTeams * 32);
+  program.SetDispatchGroupSize(row_groups);
+  program.AddInput({a, ProgramTensorMetadataDependency::TypeAndRank, 4});
+  for (const auto& [b, scales, zero_points] : matrices) {
+    program.AddInputs({{b, ProgramTensorMetadataDependency::TypeAndRank, 16},
+                       {scales, ProgramTensorMetadataDependency::TypeAndRank}});
+    if (has_zero_points) {
+      program.AddInput({zero_points, ProgramTensorMetadataDependency::None, {CeilDiv(zero_points->Shape().Size(), static_cast<int64_t>(4))}, 4});
+    }
+  }
+  if (bias != nullptr) {
+    program.AddInput({bias, ProgramTensorMetadataDependency::None});
+  }
+  program.AddOutput({y, ProgramTensorMetadataDependency::TypeAndRank});
+  // Zero points per row: the blocks rounded up to whole bytes (two per byte).
+  const uint32_t zero_blocks_per_col = CeilDiv(CeilDiv(K, block_size), 2u) * 2u;
+  program.AddUniformVariables({{N}, {K / 32}, {CeilDiv(K, block_size)}, {block_size / 32}, {zero_blocks_per_col}});
+  program.CacheHint(bias != nullptr, use_subgroups, M, rows_per_team, gated, f16, has_zero_points);
+  return context.RunProgram(program);
+}
+}  // namespace
+
+Status ApplyMatMulNBitsQ4Decode(const Tensor* a, const Tensor* b, const Tensor* scales, const Tensor* zero_points, const Tensor* bias,
+                                uint32_t M, uint32_t N, uint32_t K, uint32_t block_size,
+                                onnxruntime::webgpu::ComputeContext& context, Tensor* y) {
+  return RunQ4Decode(a, {{b, scales, zero_points}}, bias, M, N, K, block_size, context, y);
+}
+
+Status ApplyMatMulNBitsQ4DecodeGated(const Tensor* a, const Tensor* gate_b, const Tensor* gate_scales,
+                                     const Tensor* up_b, const Tensor* up_scales, uint32_t M, uint32_t N, uint32_t K,
+                                     uint32_t block_size, onnxruntime::webgpu::ComputeContext& context, Tensor* y) {
+  return RunQ4Decode(a, {{gate_b, gate_scales, nullptr}, {up_b, up_scales, nullptr}}, nullptr, M, N, K, block_size, context, y);
+}
+
+}  // namespace webgpu
+}  // namespace contrib
+}  // namespace onnxruntime
