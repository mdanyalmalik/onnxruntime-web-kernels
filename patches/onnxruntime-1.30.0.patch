+      case MoEActivationType::Relu:
+        value = "max(x, 0.0)";
+        break;
+      case MoEActivationType::Relu2:
+        value = "max(x, 0.0) * max(x, 0.0)";
+        break;
+      case MoEActivationType::Silu:
+        value = "x / (1.0 + exp(-x))";
+        break;
+      case MoEActivationType::Identity:
+        value = "x";
+        break;
+      default:
+        return ORT_MAKE_STATUS(ONNXRUNTIME, NOT_IMPLEMENTED, "This MoE activation is not supported on WebGPU.");
+    }
+    shader.MainFunctionBody() << shader.GuardAgainstOutOfBoundsWorkgroupSizes("uniforms.size")
+                              << "  let x = f32(input[global_idx]);\n"
+                              << "  output[global_idx] = output_element_t(" << value << ");\n";
+    return Status::OK();
+  }
+
+  WEBGPU_PROGRAM_DEFINE_UNIFORM_VARIABLES({"size", ProgramUniformVariableDataType::Uint32});
+
+ private:
+  MoEActivationType type_;
+};
