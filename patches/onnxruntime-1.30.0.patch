+void WebGpuContext::RecordCapturedCopy(WGPUBuffer src, WGPUBuffer dst, uint64_t size) {
+  if (graph_capture_state_ != GraphCaptureState::Capturing) {
+    return;
+  }
+  ORT_ENFORCE(external_captured_commands_ != nullptr);
+  webgpu::CapturedCommandInfo copy{};
+  copy.copy_src = src;
+  copy.copy_dst = dst;
+  copy.copy_size = size;
+  external_captured_commands_->push_back(std::move(copy));
